<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RD-12: pruebas de Notificaciones que corren sin interfaz y sin levantar la aplicación.
    Usan SQLite en memoria y un reloj controlado; Control de acceso y la Cola de correos se reemplazan por dobles
    de sus interfaces (IUsuarioActual, IDirectorioUsuarios, IColaCorreos).
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Inventario.Core.Notificaciones\Inventario.Core.Notificaciones.csproj" />
  </ItemGroup>

</Project>
