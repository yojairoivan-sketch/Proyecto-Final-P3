<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RD-12: pruebas del Manejador de documentos que corren sin interfaz y sin levantar la aplicación.
    Usan SQLite en memoria, una carpeta temporal como almacén y un reloj controlado; Control de acceso se reemplaza
    por un doble de IUsuarioActual.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Inventario.Core.Documentos\Inventario.Core.Documentos.csproj" />
  </ItemGroup>

</Project>
