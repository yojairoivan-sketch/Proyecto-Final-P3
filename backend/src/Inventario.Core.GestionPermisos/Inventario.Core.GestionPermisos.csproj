<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pieza del Core: Gestión de permisos. Responde «¿qué acceso elevado pediste y en qué estado está?».
    Requiere Control de acceso (quién es el usuario y dónde se aplica el permiso aprobado) y Notificaciones
    (avisar a los Administradores y al solicitante), solo por sus interfaces, y deja cada resolución en el historial
    de auditoría. Nunca referencia al módulo de negocio (RD-03).
  -->

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inventario.Core.Auditoria\Inventario.Core.Auditoria.csproj" />
    <ProjectReference Include="..\Inventario.Core.ControlAcceso\Inventario.Core.ControlAcceso.csproj" />
    <ProjectReference Include="..\Inventario.Core.Notificaciones\Inventario.Core.Notificaciones.csproj" />
    <ProjectReference Include="..\Inventario.Core.Reportes\Inventario.Core.Reportes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Inventario.Core.GestionPermisos.Pruebas" />
    <InternalsVisibleTo Include="Inventario.Integracion.Pruebas" />
  </ItemGroup>

</Project>
