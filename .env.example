# Copia este archivo como .env y completa los valores vacíos. .env nunca se sube al repositorio.

# --- Base de datos (PostgreSQL) ---
POSTGRES_DB=inventario
POSTGRES_USER=inventario
# Contraseña del usuario de la base. Elige una cualquiera.
POSTGRES_PASSWORD=

# --- Aplicación ---
# Dirección con la que se abre la aplicación en el navegador. Se usa para armar los enlaces de los correos.
URL_PUBLICA=http://localhost:8080

# --- Primer Administrador ---
# Se crea al arrancar la API, ya activo, si no existe una cuenta con ese correo.
# La contraseña debe tener de 8 a 128 caracteres, con letras y números.
ADMIN_NOMBRE=
ADMIN_CORREO=
ADMIN_CONTRASENA=

# --- Correo saliente (solo lo usa el enviador: docker compose run --rm enviador) ---
# Por defecto apunta a Mailpit, el servidor de pruebas del compose (bandeja en http://localhost:8025).
# Para correo real con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PUERTO=587, SMTP_SEGURIDAD=StartTls,
# SMTP_USUARIO y SMTP_REMITENTE = tu dirección de Gmail, SMTP_CONTRASENA = una contraseña de aplicación.
SMTP_HOST=mailpit
SMTP_PUERTO=1025
# Ninguna, StartTls o SslAlConectar.
SMTP_SEGURIDAD=Ninguna
# Usuario y contraseña del servidor SMTP. Vacíos para Mailpit.
SMTP_USUARIO=
SMTP_CONTRASENA=
# Dirección que aparece como remitente de los correos.
SMTP_REMITENTE=

# --- Puertos (opcionales) ---
# Descomenta si el 8080 o el 8025 están ocupados. Si cambias WEB_PUERTO, cambia también URL_PUBLICA.
# WEB_PUERTO=8080
# MAILPIT_PUERTO=8025
