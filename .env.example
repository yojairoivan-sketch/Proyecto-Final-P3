# Copia este archivo como .env:   cp .env.example .env
# Trae un valor de ejemplo para cada variable, así que con eso basta para levantar el proyecto con
# docker compose up --build. .env nunca se sube al repositorio (.gitignore lo excluye).
# Para usarlo de verdad, cambia las contraseñas y pon tu clave de la API de tasas de cambio.

# --- Base de datos (PostgreSQL) ---
POSTGRES_DB=inventario
POSTGRES_USER=inventario
POSTGRES_PASSWORD=clave-de-ejemplo-123

# --- Aplicación ---
# Dirección con la que se abre la aplicación en el navegador. Se usa para armar los enlaces de los correos.
# Si cambias WEB_PUERTO, cambia también el puerto aquí.
URL_PUBLICA=http://localhost:8080
# Puerto de tu equipo en el que responde la aplicación. Es el único que publica el proyecto.
WEB_PUERTO=8080

# --- Primer Administrador ---
# Se crea al arrancar la API, ya activo, si no existe una cuenta con ese correo.
# La contraseña debe tener de 8 a 128 caracteres, con letras y números.
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=admin@inventario.local
ADMIN_CONTRASENA=Admin12345

# --- Correo saliente (lo usa el enviador, que entrega la cola cada 5 segundos) ---
# Por defecto apunta a Mailpit, el servidor de pruebas del compose: los correos se ven en http://localhost:8080/correo/
# Mailpit acepta cualquier usuario y contraseña, como los de ejemplo.
# Para correo real con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PUERTO=587, SMTP_SEGURIDAD=StartTls,
# SMTP_USUARIO y SMTP_REMITENTE = tu dirección de Gmail, SMTP_CONTRASENA = una contraseña de aplicación.
SMTP_HOST=mailpit
SMTP_PUERTO=1025
# Ninguna, StartTls o SslAlConectar.
SMTP_SEGURIDAD=Ninguna
SMTP_USUARIO=inventario
SMTP_CONTRASENA=clave-de-ejemplo
# Dirección que aparece como remitente de los correos.
SMTP_REMITENTE=inventario@inventario.local

# --- API externa de tasas de cambio (ExchangeRate-API) ---
# La usa la cotización de una orden de compra en otra moneda (GET /api/ordenes/{id}/cotizacion?moneda=USD).
# Pide una clave gratis en https://www.exchangerate-api.com y ponla aquí. Con este valor de ejemplo la cotización
# se rechaza con un mensaje (503) y el resto de la aplicación funciona igual.
TASA_CAMBIO_API_CLAVE=clave-de-ejemplo
